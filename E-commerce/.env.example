# E-commerce project environment variables
# Copy the Django variables to backend/.env.
# Copy the Vite variable to frontend/.env.

# Django / PostgreSQL
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=your-postgresql-password
DB_HOST=localhost
DB_PORT=5432

# Frontend
# Do not add a trailing slash. Vite exposes variables prefixed with VITE_ to the browser.
VITE_DJANGO_BASE_URL=http://127.0.0.1:8000
